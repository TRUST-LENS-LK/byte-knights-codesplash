# ==============================================================
# TrustLens LK — Unified Monorepo Environment Template
# Copy this file to .env and fill in your keys:
# cp .env.example .env
# ==============================================================

# --- Frontend (apps/web) ---
VITE_API_URL=http://localhost:8787

# --- Backend API (services/api) ---
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Scanner Service URL
SCANNER_URL=http://localhost:8789

# Database & Supabase (Required for reports, moderation, audit logs)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Threat Intelligence APIs (Optional — fails open if unset)
GOOGLE_SAFE_BROWSING_API_KEY=
GEMINI_API_KEY=
