SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed to run test/domainDirectoryRls.test.mjs locally, which
# verifies Row Level Security behaves correctly for a public (anon) caller.
SUPABASE_ANON_KEY=
PORT=8787
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# Optional: base URL of the scanner service (services/scanner), used to fetch
# page text for URLs found in a submission. Analysis still works without it.
SCANNER_URL=http://localhost:8788
# Optional: must match the scanner service's own SCANNER_SHARED_SECRET. Left
# unset, the scanner accepts requests from anyone who can reach it.
SCANNER_SHARED_SECRET=
# Optional: Google Safe Browsing API v4 key, for Tier 4 live threat
# reputation checks. Fails open (analysis continues without this tier) when
# unset. Get one from Google Cloud Console (enable the Safe Browsing API).
GOOGLE_SAFE_BROWSING_API_KEY=


