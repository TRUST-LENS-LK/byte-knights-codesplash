{
  "_meta": {
    "version": "1.0.0",
    "description": "TrustLens LK — Ground-truth expected entity extraction results. Each case maps raw input text to the exact entities the extraction package must produce.",
    "fields": {
      "type": "Entity type: url | domain | phone | email | amount | organization",
      "value": "Exact matched substring from raw input",
      "normalizedValue": "Canonicalized form of the matched value",
      "startIndex": "Zero-based index where entity starts in the raw input string",
      "endIndex": "Zero-based index immediately after entity ends in the raw input string"
    }
  },

  "cases": [
    {
      "id": "EXT-001",
      "description": "Standard HTTPS URL extraction",
      "input": "Visit http://fake-recruitment.lk for details.",
      "expectedEntities": [
        {
          "type": "url",
          "value": "http://fake-recruitment.lk",
          "normalizedValue": "http://fake-recruitment.lk",
          "startIndex": 6,
          "endIndex": 32
        },
        {
          "type": "domain",
          "value": "fake-recruitment.lk",
          "normalizedValue": "fake-recruitment.lk",
          "startIndex": 13,
          "endIndex": 32
        }
      ]
    },
    {
